{
  "name": "Раш · Сложный",
  "description": "Разведчики тройками по всем Дорогам, на короткой — со Стрелком; добивают слабейших и рано уходят лечиться.",
  "scout": [
    {"when": {"kind": "hp-below", "percent": 45}, "do": {"kind": "retreat"}},
    {"when": {"kind": "enemy-in-range"}, "do": {"kind": "attack-weakest"}},
    {"when": [{"kind": "at-home"}, {"kind": "hp-below", "percent": 100}], "do": {"kind": "retreat"}},
    {"when": {"kind": "always"}, "do": {"kind": "advance"}}
  ],
  "tank": [
    {"when": {"kind": "enemy-in-range"}, "do": {"kind": "attack-nearest"}},
    {"when": {"kind": "always"}, "do": {"kind": "advance"}}
  ],
  "ranger": [
    {"when": {"kind": "hp-below", "percent": 50}, "do": {"kind": "retreat"}},
    {"when": {"kind": "enemy-in-range"}, "do": {"kind": "attack-weakest"}},
    {"when": [{"kind": "at-home"}, {"kind": "hp-below", "percent": 100}], "do": {"kind": "retreat"}},
    {"when": {"kind": "always"}, "do": {"kind": "advance"}}
  ],
  "waves": [
    {"road": "north", "units": ["scout", "scout", "scout"]},
    {"road": "south", "units": ["scout", "scout", "scout"]},
    {"road": "short", "units": ["scout", "scout", "ranger"]}
  ]
}
